# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채우세요.
#   cp .env.example .env.local

# Supabase 대시보드 > Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 로그인을 허용할 학교 구글 도메인 (@ 없이).
# 비워두면 도메인 검증이 통째로 건너뛰어지므로 반드시 채울 것.
NEXT_PUBLIC_SCHOOL_DOMAIN=dshs.kr

# NEIS 교육정보 개방 포털(open.neis.go.kr) 인증키. 급식 조회에 쓴다.
# 서버 전용이므로 NEXT_PUBLIC_ 을 붙이지 말 것. 비워두면 급식이 표시되지 않는다.
NEIS_API_KEY=